{
  "name": "steward",
  "version": "0.1.0",
  "description": "Steward brings CI/CD, deployments, infrastructure, and observability together in one workspace.",
  "license": "Apache-2.0",
  "author": "Ian Mora",
  "main": "out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint",
    "package": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
